              {
                "key": "Accept-Language",
                "value": "{{language}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ],
              "query": [],
              "variable": []
            },
            "description": "The process is running. Public; does not touch any dependency."
          }
        },
        {
          "name": "Readiness probe",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
