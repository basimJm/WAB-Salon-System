{
  "info": {
    "name": "WAB Merchant API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Generated by `npm run docs`. Do not edit by hand."
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "OTP pre-check",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/merchant/v1/auth/otp/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "merchant",
                "v1",
                "auth",
                "otp",
                "request"
              ],
              "query": [],
              "variable": []
            },
            "description": "Public. Checks the platform limits before the app asks Firebase to send the SMS. A blocked phone or a running resend countdown answers 200 with `allowed: false`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"string\",\n  \"purpose\": \"LOGIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Report a wrong OTP code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/merchant/v1/auth/otp/wrong-attempt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "merchant",
                "v1",
                "auth",
                "otp",
                "wrong-attempt"
              ],
              "query": [],
              "variable": []
            },
            "description": "Public. The app reports a wrong code from Firebase; it counts toward the wrong-attempts block.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Check a number before sending the OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/merchant/v1/auth/check-phone",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "merchant",
                "v1",
                "auth",
                "check-phone"
              ],
              "query": [],
              "variable": []
            },
            "description": "404 `PHONE_NOT_REGISTERED` when the number is not linked to a salon (the app offers to register one); 403 `MEMBER_INACTIVE` when the owner removed the member.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": {\n    \"countryCode\": \"string\",\n    \"number\": \"string\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Log in with a Firebase ID token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/merchant/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "merchant",
                "v1",
                "auth",
                "login"
              ],
              "query": [],
              "variable": []
            },
            "description": "The token must prove the phone. Errors: `OTP_INVALID`, `OTP_EXPIRED` (401), `OTP_BLOCKED` (429), `MEMBER_INACTIVE` (403), `PHONE_NOT_REGISTERED` (404). The profile carries role, salon and permissions for the app to cache.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": {\n    \"countryCode\": \"string\",\n    \"number\": \"string\"\n  },\n  \"idToken\": \"string\",\n  \"installation\": {\n    \"installationId\": \"string\",\n    \"platform\": \"ANDROID\",\n    \"appVersion\": \"string\",\n    \"osVersion\": \"string\",\n    \"deviceModel\": \"string\",\n    \"fcmToken\": \"string\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Rotate the refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/merchant/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "merchant",
                "v1",
                "auth",
                "refresh"
              ],
              "query": [],
              "variable": []
            },
            "description": "Returns a new token pair and the current profile. Reusing an old refresh token ends every session of that login (401). A removed member gets 403 `MEMBER_INACTIVE` and all sessions end.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/merchant/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "merchant",
                "v1",
                "auth",
                "logout"
              ],
              "query": [],
              "variable": []
            },
            "description": "Revokes the refresh token and unlinks the device. Always succeeds for well-formed tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Installations",
      "item": [
        {
          "name": "Register or update this device",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{merchantToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/merchant/v1/installations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "merchant",
                "v1",
                "installations"
              ],
              "query": [],
              "variable": []
            },
            "description": "Firebase app-instance id, FCM token and versions. Links the device to the signed-in member so the salon's booking requests reach it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"installationId\": \"string\",\n  \"platform\": \"ANDROID\",\n  \"appVersion\": \"string\",\n  \"osVersion\": \"string\",\n  \"deviceModel\": \"string\",\n  \"fcmToken\": \"string\",\n  \"language\": \"ar\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "App config",
      "item": [
        {
          "name": "Version policy, maintenance, OTP and discovery settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/merchant/v1/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "merchant",
                "v1",
                "config"
              ],
              "query": [
                {
                  "key": "platform",
                  "value": ""
                },
                {
                  "key": "version",
                  "value": ""
                }
              ],
              "variable": []
            },
            "description": "Public. Called at launch with the installed version: tells the app whether it must or may update, whether maintenance is on, plus OTP length/resend and the nearby radius."
          }
        }
      ]
    },
