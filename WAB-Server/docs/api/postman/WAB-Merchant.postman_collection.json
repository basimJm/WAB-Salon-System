    {
      "name": "Salon application",
      "item": [
        {
          "name": "Apply with a new salon (creates the owner, signs them in)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/merchant/v1/salon/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "merchant",
                "v1",
                "salon",
                "applications"
              ],
              "query": [],
              "variable": []
            },
            "description": "Public. The phone is proven by a Firebase ID token. The salon waits for admin approval; license documents are private storage keys.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": {\n    \"countryCode\": \"string\",\n    \"number\": \"string\"\n  },\n  \"idToken\": \"string\",\n  \"firstName\": \"string\",\n  \"lastName\": \"string\",\n  \"salon\": {\n    \"name\": \"string\",\n    \"gender\": \"MALE\",\n    \"description\": \"string\",\n    \"cityId\": \"string\",\n    \"areaId\": \"string\"\n  },\n  \"documentKeys\": [\n    \"string\"\n  ],\n  \"installation\": {\n    \"installationId\": \"string\",\n    \"platform\": \"ANDROID\",\n    \"appVersion\": \"string\",\n    \"osVersion\": \"string\",\n    \"deviceModel\": \"string\",\n    \"fcmToken\": \"string\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
