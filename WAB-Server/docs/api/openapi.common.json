{
  "openapi": "3.1.0",
  "info": {
    "title": "WAB Common",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "PERMISSION_DENIED",
                  "NOT_FOUND",
                  "CONFLICT",
                  "RATE_LIMITED",
                  "INTERNAL",
                  "OTP_BLOCKED",
                  "OTP_INVALID",
                  "OTP_EXPIRED",
                  "PHONE_NOT_REGISTERED",
                  "PHONE_ALREADY_REGISTERED",
                  "ACCOUNT_BLOCKED",
                  "CURRENT_PASSWORD_INVALID",
                  "EMAIL_ALREADY_USED",
                  "MEMBER_INACTIVE",
                  "SALON_NOT_FOUND",
                  "SALON_NOT_BOOKABLE",
                  "BRANCH_NOT_FOUND",
                  "BRANCH_NOT_BOOKABLE",
                  "BRANCH_REQUIRED",
                  "BRANCH_LIMIT_REACHED",
                  "BRANCH_HAS_UPCOMING_BOOKINGS",
                  "LAST_BRANCH",
                  "BRANCH_SCOPE_DENIED",
                  "SALON_CLOSED",
                  "GENDER_MISMATCH",
                  "TOO_MANY_COMPANIONS",
                  "SERVICE_UNAVAILABLE",
                  "BRIDE_ONLY_SERVICE",
                  "STAFF_NOT_ELIGIBLE",
                  "SLOT_UNAVAILABLE",
                  "SLOT_TAKEN",
                  "DATE_OUT_OF_RANGE",
                  "PAYMENT_FAILED",
                  "PAYMENT_NOT_VERIFIED",
                  "PAYMENT_OPTION_NOT_ALLOWED",
                  "DRAFT_EXPIRED",
                  "INVALID_TRANSITION",
                  "CANCELLATION_WINDOW_PASSED",
                  "TOO_EARLY_TO_COMPLETE",
                  "ALREADY_HANDLED",
                  "SCHEDULE_CONFLICT",
                  "OWNER_REQUIRED",
                  "LAST_OWNER",
                  "UPLOAD_INVALID",
                  "UPLOAD_TOO_LARGE",
                  "MAINTENANCE",
                  "UPDATE_REQUIRED"
                ]
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              },
              "traceId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "details",
              "traceId"
            ]
          }
        },
        "required": [
          "success",
          "message",
          "error"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "page",
          "pageSize",
          "total"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe",
        "description": "The process is running. Public; does not touch any dependency.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en"
              ],
              "description": "Response language; default ar."
            },
            "required": false,
            "description": "Response language; default ar.",
            "name": "Accept-Language",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ok"
                          ]
                        }
                      },
                      "required": [
                        "status"
                      ]
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness probe",
        "description": "Every dependency check (MongoDB, Redis...) passes. Public. 503 lists the dependencies that are down.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en"
              ],
              "description": "Response language; default ar."
            },
            "required": false,
            "description": "Response language; default ar.",
            "name": "Accept-Language",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ok"
                          ]
                        },
                        "checks": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "up",
                                  "down"
                                ]
                              }
                            },
                            "required": [
                              "name",
                              "status"
                            ]
                          }
                        }
                      },
                      "required": [
                        "status",
                        "checks"
                      ]
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/payments": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Payment gateway notification (called by the gateway, not by the apps)",
        "description": "Authenticated by the gateway signature over the raw body (HyperPay: AES-256-GCM `X-Authentication-Tag` + `X-Initialization-Vector`, body is the encrypted message; the fake gateway: `X-Signature`); a bad or missing signature is 401. The outcome is confirmed with a status query before anything is settled, so a repeated or forged-content notification changes nothing. Unknown sessions are acknowledged. Answers 200 `{settled}`.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "x-authentication-tag",
            "in": "header"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "x-signature",
            "in": "header"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "x-initialization-vector",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {},
                "description": "Gateway payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "settled": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "settled"
                      ]
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/assetlinks.json": {
      "get": {
        "tags": [
          "App links"
        ],
        "summary": "Android App Links verification (Digital Asset Links)",
        "description": "One entry per configured Android package. Platform format, not the base envelope. Public; always 200, never redirected.",
        "responses": {
          "200": {
            "description": "Asset links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "relation": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "delegate_permission/common.handle_all_urls"
                          ]
                        }
                      },
                      "target": {
                        "type": "object",
                        "properties": {
                          "namespace": {
                            "type": "string",
                            "enum": [
                              "android_app"
                            ]
                          },
                          "package_name": {
                            "type": "string"
                          },
                          "sha256_cert_fingerprints": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "namespace",
                          "package_name",
                          "sha256_cert_fingerprints"
                        ]
                      }
                    },
                    "required": [
                      "relation",
                      "target"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/apple-app-site-association": {
      "get": {
        "tags": [
          "App links"
        ],
        "summary": "iOS Universal Links verification (apple-app-site-association)",
        "description": "Configured app IDs claim the salon path. Platform format, not the base envelope. Public; always 200, never redirected.",
        "responses": {
          "200": {
            "description": "Apple app site association",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "applinks": {
                      "type": "object",
                      "properties": {
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "appIDs": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "components": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "/": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "/"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "appIDs",
                              "components"
                            ]
                          }
                        }
                      },
                      "required": [
                        "details"
                      ]
                    }
                  },
                  "required": [
                    "applinks"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/salon/{salonId}": {
      "get": {
        "tags": [
          "App links"
        ],
        "summary": "Shared salon link: fallback page for a phone without the app",
        "description": "Small localized HTML page (noindex) with store buttons. The app opens this URL directly when installed.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "salonId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en"
              ],
              "description": "Response language; default ar."
            },
            "required": false,
            "description": "Response language; default ar.",
            "name": "Accept-Language",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Fallback page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
