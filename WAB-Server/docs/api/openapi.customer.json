{
  "openapi": "3.1.0",
  "info": {
    "title": "WAB Customer API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "PERMISSION_DENIED",
                  "NOT_FOUND",
                  "CONFLICT",
                  "RATE_LIMITED",
                  "INTERNAL",
                  "OTP_BLOCKED",
                  "OTP_INVALID",
                  "OTP_EXPIRED",
                  "PHONE_NOT_REGISTERED",
                  "PHONE_ALREADY_REGISTERED",
                  "ACCOUNT_BLOCKED",
                  "MEMBER_INACTIVE",
                  "SALON_NOT_FOUND",
                  "SALON_NOT_BOOKABLE",
                  "SALON_CLOSED",
                  "GENDER_MISMATCH",
                  "TOO_MANY_COMPANIONS",
                  "SERVICE_UNAVAILABLE",
                  "BRIDE_ONLY_SERVICE",
                  "STAFF_NOT_ELIGIBLE",
                  "SLOT_UNAVAILABLE",
                  "SLOT_TAKEN",
                  "DATE_OUT_OF_RANGE",
                  "PAYMENT_FAILED",
                  "PAYMENT_NOT_VERIFIED",
                  "PAYMENT_OPTION_NOT_ALLOWED",
                  "DRAFT_EXPIRED",
                  "INVALID_TRANSITION",
                  "CANCELLATION_WINDOW_PASSED",
                  "TOO_EARLY_TO_COMPLETE",
                  "ALREADY_HANDLED",
                  "SCHEDULE_CONFLICT",
                  "OWNER_REQUIRED",
                  "LAST_OWNER",
                  "UPLOAD_INVALID",
                  "UPLOAD_TOO_LARGE",
                  "MAINTENANCE",
                  "UPDATE_REQUIRED"
                ]
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              },
              "traceId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "details",
              "traceId"
            ]
          }
        },
        "required": [
          "success",
          "message",
          "error"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "page",
          "pageSize",
          "total"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/customer/v1/auth/otp/request": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "OTP pre-check",
        "description": "Public. Checks the platform limits before the app asks Firebase to send the SMS. A blocked phone or a running resend countdown answers 200 with `allowed: false`.",
        "security": [],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en"
              ],
              "description": "Response language; default ar."
            },
            "required": false,
            "description": "Response language; default ar.",
            "name": "Accept-Language",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+[1-9][0-9]{6,14}$"
                  },
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "LOGIN",
                      "REGISTER",
                      "CHANGE_PHONE",
                      "BOOKING_CONFIRMATION"
                    ]
                  }
                },
                "required": [
                  "phone",
                  "purpose"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "allowed": {
                          "type": "boolean",
                          "description": "The app may now ask Firebase to send the SMS."
                        },
                        "otpLength": {
                          "type": "integer",
                          "description": "Number of code boxes; never hardcode it in the app."
                        },
                        "resendAfterSeconds": {
                          "type": "integer",
                          "description": "Resend countdown in seconds."
                        },
                        "blockedUntil": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Set while the phone is blocked (UTC)."
                        }
                      },
                      "required": [
                        "allowed",
                        "otpLength",
                        "resendAfterSeconds"
                      ]
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/customer/v1/auth/otp/wrong-attempt": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Report a wrong OTP code",
        "description": "Public. The app reports a wrong code from Firebase; it counts toward the wrong-attempts block.",
        "security": [],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en"
              ],
              "description": "Response language; default ar."
            },
            "required": false,
            "description": "Response language; default ar.",
            "name": "Accept-Language",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+[1-9][0-9]{6,14}$"
                  }
                },
                "required": [
                  "phone"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Attempts left or the block",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "blocked": {
                          "type": "boolean"
                        },
                        "attemptsRemaining": {
                          "type": "integer"
                        },
                        "blockedUntil": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "blocked",
                        "attemptsRemaining"
                      ]
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
