# Template for the PRODUCTION environment (and, with other values, the shared dev server).
# Real values go in the host's secret store, never in git. Replace every placeholder value, then check:
#   npm run build && npm run env:check -- <your env file>     (prints key names only, never values)
# Production refuses fakes: otp, storage and notifier must be `real`; payments must be `disabled`.
NODE_ENV=production
PORT=REPLACE_ME
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=REPLACE_ME
# Number of reverse proxies / load balancers in front of the API.
TRUST_PROXY_HOPS=REPLACE_ME
MONGODB_URI=REPLACE_ME
REDIS_URL=REPLACE_ME
# openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_ME
# openssl rand -base64 32 (exactly 32 random bytes, base64)
PAYOUT_ENCRYPTION_KEY=REPLACE_ME
OTP_PROVIDER=real
STORAGE_PROVIDER=real
NOTIFIER_PROVIDER=real
PAYMENT_PROVIDER=disabled
# OTP: the Firebase project of THIS environment (dev and prod are different projects).
FIREBASE_PROJECT_ID=REPLACE_ME
# Notifier: Firebase service account JSON of this environment (one line) + Gmail SMTP.
FCM_SERVICE_ACCOUNT_JSON=REPLACE_ME
SMTP_HOST=REPLACE_ME
SMTP_PORT=REPLACE_ME
SMTP_SECURE=REPLACE_ME
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
EMAIL_FROM_ADDRESS=REPLACE_ME
EMAIL_FROM_NAME=REPLACE_ME
# Storage: AWS S3 + CDN. Leave the access keys out to use the platform's IAM role.
S3_REGION=REPLACE_ME
S3_PUBLIC_BUCKET=REPLACE_ME
S3_PRIVATE_BUCKET=REPLACE_ME
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
CDN_BASE_URL=REPLACE_ME
