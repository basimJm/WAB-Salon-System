# Hosted DEV environment (Render service "wab-server-dev", branch `server`).
# Enter every key below on Render: service -> Environment. Real values go there (or in your host's
# secret store), never in git. A value that is already filled is fixed for this environment.
# Before you deploy, put the same values in a local file and check it (names only, never values):
#   npm run build && npm run env:check -- <your file>
# Use dev values everywhere: dev database, dev Redis, dev Firebase project, dev buckets.

# --- Runtime -------------------------------------------------------------------------------
# Production mode: the server refuses fakes and weak settings. Dev and prod both use it.
NODE_ENV=production
# How much the server logs: fatal, error, warn, info, debug. info is right for a live server.
LOG_LEVEL=info
# Number of proxies in front of the server. Render's proxy = 1 (needed for the real client IP).
TRUST_PROXY_HOPS=1
# Addresses allowed to call the API from a browser: the admin panel, comma separated.
CORS_ALLOWED_ORIGINS=REPLACE_ME

# --- App Links / Universal Links (shared salon links https://<host>/salon/{id}) -----------
# Android package names of the customer app, comma separated (e.g. the applicationId per variant).
APP_LINKS_ANDROID_PACKAGES=
# SHA-256 signing-certificate fingerprints (AA:BB:...), comma separated: `./gradlew signingReport`,
# `keytool -list -v -keystore <keystore>`, or Play Console -> App integrity -> App signing key.
APP_LINKS_ANDROID_SHA256=
# iOS app IDs `<TEAM_ID>.<bundleId>`, comma separated (Team ID: Apple Developer -> Membership).
APP_LINKS_IOS_APP_IDS=
# Optional store links for the no-app fallback page; leave empty to hide a button.
APP_LINKS_PLAY_STORE_URL=
APP_LINKS_APP_STORE_URL=

# --- Database and cache ------------------------------------------------------------------
# MongoDB Atlas connection string: Atlas -> Connect -> Drivers. Holds user, password, database.
MONGODB_URI=REPLACE_ME
# Redis URL: Render -> your Key Value (Redis) -> Internal URL.
REDIS_URL=REPLACE_ME

# --- Secrets generated by you (a different value in dev and prod) ------------------------
# Signs login tokens. Run: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_ME
# Encrypts salon bank details (IBAN). Run: openssl rand -base64 32. Never change it later.
PAYOUT_ENCRYPTION_KEY=REPLACE_ME

# --- Which integrations are real (production needs these exact values) -------------------
OTP_PROVIDER=arqam
# Files: cloudflare-r2 (active, SRV-180); `real` = the AWS S3 fallback (then fill the S3_* block instead).
STORAGE_PROVIDER=cloudflare-r2
NOTIFIER_PROVIDER=real
# Payments are paused: the server answers "unavailable" on checkout.
PAYMENT_PROVIDER=disabled

# --- Phone OTP over WhatsApp through ARQAM OTP (owner guide: wab-otp/docs/ARQAM_SETUP.md) ------
# ARQAM dashboard -> API Keys: the TEST key of the WAB project (secret).
ARQAM_API_KEY=REPLACE_ME
# Authentication template names exactly as ARQAM shows them (Arabic and English).
ARQAM_TEMPLATE_AR=REPLACE_ME
ARQAM_TEMPLATE_EN=REPLACE_ME
# Optional: only when ARQAM answers SENDER_REQUIRED (several approved senders).
# ARQAM_SENDER_ID=
# Optional: true only when IP rate limiting is on in the ARQAM project.
# ARQAM_SEND_IP=false
# Optional: leave out to use https://otp.arqam.tech/api.
# ARQAM_BASE_URL=
# Two different secrets, each from: openssl rand -base64 48
OTP_CODE_SECRET=REPLACE_ME
OTP_PROOF_SECRET=REPLACE_ME

# --- Firebase (push) ---------------------------------------------------------------------
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Paste the whole downloaded JSON file as one line.
FCM_SERVICE_ACCOUNT_JSON=REPLACE_ME

# --- Email (Gmail) -----------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# The Gmail address that sends the mail.
SMTP_USER=REPLACE_ME
# Google account -> Security -> 2-Step Verification -> App passwords (16 characters).
SMTP_PASS=REPLACE_ME
# The "from" address (the same Gmail address) and the sender name users see.
EMAIL_FROM_ADDRESS=REPLACE_ME
EMAIL_FROM_NAME=WAB

# --- Files and photos (Cloudflare R2) ------------------------------------------------------
# Cloudflare dashboard -> R2. Make TWO buckets for this environment: one public (salon photos,
# avatars) and one private (license documents). Never turn on public access for the private one.
# Account ID (R2 overview page, right column).
R2_ACCOUNT_ID=REPLACE_ME
# R2 -> Manage API tokens -> Create token with "Object Read & Write" on both buckets only.
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
# Bucket names, for example wab-dev-public and wab-dev-private (they must differ).
R2_PUBLIC_BUCKET_NAME=REPLACE_ME
R2_PRIVATE_BUCKET_NAME=REPLACE_ME
# Public address of the public bucket (its custom domain, or the r2.dev URL); must start with https://
R2_PUBLIC_URL=REPLACE_ME
# Optional: leave unset for https://<account>.r2.cloudflarestorage.com (set only for an EU/FedRAMP endpoint).
# R2_ENDPOINT=

# AWS S3 fallback (STORAGE_PROVIDER=real) - only when not using R2:
# S3_REGION=
# S3_PUBLIC_BUCKET=
# S3_PRIVATE_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CDN_BASE_URL=

# --- Demo data (dev only; docs/DEMO_ACCOUNTS.md) -------------------------------------------
# true = after each start, run `seed:dev`: the demo salons, branches, staff, bookings, reviews,
# images (with the storage keys above) and reports that are missing (insert-only; a finished seed
# is skipped). Needs an admin: from `seed:admin`, or set ADMIN_EMAIL / ADMIN_PASSWORD here once.
SEED_DEMO_ON_START=false
# Production rules (NODE_ENV=production) allow it only on the database named here: the database
# name in MONGODB_URI (the part after the host and "/"). Uncomment with the DEV database name only.
# SEED_DEMO_DATABASE=<the dev database name>
