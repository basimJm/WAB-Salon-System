# Keys only. Real values live in .env.development / .env.production (never committed).
# Every key read by src/config must be listed here (checked by tests/config.test.ts).
NODE_ENV=
PORT=
LOG_LEVEL=
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=
MONGODB_URI=
REDIS_URL=
JWT_ACCESS_SECRET=
PAYOUT_ENCRYPTION_KEY=
OTP_PROVIDER=
STORAGE_PROVIDER=
NOTIFIER_PROVIDER=
PAYMENT_PROVIDER=
ANALYTICS_PROVIDER=

# Real notifier (NOTIFIER_PROVIDER=real): Firebase push + SMTP email. Values go in the real
# environment or a git-ignored .env.<env> file, never in git.
# Real OTP (OTP_PROVIDER=real): Firebase project whose Phone Auth ID tokens are accepted (dev and prod
# are different projects). The emulator host is for development only and refused in production.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
FCM_DRY_RUN=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Real storage (STORAGE_PROVIDER=real): S3 + CDN. Credentials unset = the platform's IAM role.
S3_REGION=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
# Optional CloudFront signing for private files (all three, or none: S3 presigned GET is used).
CLOUDFRONT_PRIVATE_BASE_URL=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
