# Keys only. Real values live in .env.development / .env.production (never committed).
# Every key read by src/config must be listed here (checked by tests/config.test.ts).
NODE_ENV=
PORT=
LOG_LEVEL=
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=
# App Links / Universal Links for shared salon links (comma lists; empty = none). Store URLs optional.
APP_LINKS_ANDROID_PACKAGES=
APP_LINKS_ANDROID_SHA256=
APP_LINKS_IOS_APP_IDS=
APP_LINKS_PLAY_STORE_URL=
APP_LINKS_APP_STORE_URL=
MONGODB_URI=
REDIS_URL=
JWT_ACCESS_SECRET=
PAYOUT_ENCRYPTION_KEY=
OTP_PROVIDER=
STORAGE_PROVIDER=
NOTIFIER_PROVIDER=
# Payments are paused: `fake` (dev/test) or `disabled` (production must say `disabled`).
PAYMENT_PROVIDER=

# Real notifier (NOTIFIER_PROVIDER=real): Firebase push + SMTP email. Values go in the real
# environment or a git-ignored .env.<env> file, never in git.
# Phone OTP (BUSINESS_DOMAIN 3.1a): OTP_PROVIDER=arqam (production) or fake (dev/test: codes are
# recorded, not sent). arqam (ARQAM OTP delivers our code over WhatsApp; owner guide
# wab-otp/docs/ARQAM_SETUP.md) needs the project API key (TEST key in dev, LIVE key in production),
# the Arabic and English authentication template names and both secrets (each >= 32 characters,
# different; openssl rand -base64 48). Optional: ARQAM_BASE_URL (https in production),
# ARQAM_SENDER_ID (only when ARQAM answers SENDER_REQUIRED), ARQAM_SEND_IP=true (only when the
# ARQAM project has IP rate limiting). fake makes per-process secrets when they are unset.
# OTP_FIXED_CODE (dev only, refused in production) makes every code that value so local QA can
# sign in (request a code, then verify it with this value).
ARQAM_API_KEY=
ARQAM_BASE_URL=
ARQAM_TEMPLATE_AR=
ARQAM_TEMPLATE_EN=
ARQAM_SENDER_ID=
ARQAM_SEND_IP=
OTP_CODE_SECRET=
OTP_PROOF_SECRET=
OTP_FIXED_CODE=
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
FCM_DRY_RUN=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Cloudflare R2 (STORAGE_PROVIDER=cloudflare-r2, the active provider, SRV-180). Two buckets: the public
# one has public access (custom domain or r2.dev = R2_PUBLIC_URL); the private one never does.
# R2_ENDPOINT is optional (default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com). Server-side only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# AWS S3 fallback (STORAGE_PROVIDER=real): S3 + CDN. Credentials unset = the platform's IAM role.
S3_REGION=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
# Optional CloudFront signing for private files (all three, or none: S3 presigned GET is used).
CLOUDFRONT_PRIVATE_BASE_URL=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Demo data (SRV-160/173, development data only): `true` runs the idempotent `seed:dev` after startup
# (data, branches, images with real storage, reports; ADMIN_EMAIL/ADMIN_PASSWORD create the admin if none).
# Under NODE_ENV=production (the hosted dev service) it also needs SEED_DEMO_DATABASE = the name of
# the database the server is connected to; never set either on the real production service.
SEED_DEMO_ON_START=
SEED_DEMO_DATABASE=
