# Keys only. Real values live in .env.development / .env.production (never committed).
# Every key read by src/config must be listed here (checked by tests/config.test.ts).
NODE_ENV=
PORT=
LOG_LEVEL=
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=
MONGODB_URI=
REDIS_URL=
JWT_ACCESS_SECRET=
PAYOUT_ENCRYPTION_KEY=
OTP_PROVIDER=
STORAGE_PROVIDER=
NOTIFIER_PROVIDER=
PAYMENT_PROVIDER=
ANALYTICS_PROVIDER=

# Real notifier (NOTIFIER_PROVIDER=real): Firebase push + SMTP email. Values go in the real
# environment or a git-ignored .env.<env> file, never in git.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
FCM_DRY_RUN=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
