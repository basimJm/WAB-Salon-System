// Development environment: used by the Debug-Dev and Release-Dev configurations (scheme iosApp-Dev).
#include "Config.xcconfig"

APP_ENV = dev
APP_DISPLAY_NAME = WAB Dev
// PLACEHOLDER host until the platform domain is decided. In xcconfig '//' starts a comment, so the
// scheme separator is written as ':/$()/'.
API_BASE_URL = https:/$()/dev-api.template.app
WEB_BASE_URL = https:/$()/dev.template.app
// Universal Links domain (PRD §4.4) = the WEB_BASE_URL host; used by iosApp.entitlements.
DEEP_LINK_HOST = dev.template.app
// Set a suffix (for example .dev) only when the Firebase project has a matching iOS app.
// Dev builds run on fixtures until the dev API exists (CUS-060 switches to remote).
DATA_SOURCE = mock
BUNDLE_ID_SUFFIX = .dev
PRODUCT_BUNDLE_IDENTIFIER = com.fab.wab.customer$(BUNDLE_ID_SUFFIX)$(TEAM_ID)
// Merchant app hand-off (CUS-056, PLACEHOLDERS until the merchant app ships): deep link, App Store page, URL scheme.
MERCHANT_REGISTER_URL = https:/$()/merchant-dev.template.app/register
MERCHANT_STORE_URL = https:/$()/apps.apple.com/app/id0000000000
MERCHANT_APP_SCHEME = wabmerchant
