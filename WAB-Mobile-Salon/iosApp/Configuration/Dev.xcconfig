// Development environment: used by the Debug-Dev and Release-Dev configurations (scheme iosApp-Dev).
#include "Config.xcconfig"

APP_ENV = dev
APP_DISPLAY_NAME = WAB Business Dev
// PLACEHOLDER host until the platform domain is decided. In xcconfig '//' starts a comment, so the
// scheme separator is written as ':/$()/'.
API_BASE_URL = https:/$()/wab-server-dev.onrender.com
WEB_BASE_URL = https:/$()/wab-server-dev.onrender.com
// Universal Links domain = the WEB_BASE_URL host; used by iosApp.entitlements.
DEEP_LINK_HOST = wab-server-dev.onrender.com
// Set a suffix (for example .dev) only when the Firebase project has a matching iOS app.
// Dev builds run on fixtures until the dev API exists.
DATA_SOURCE = remote
BUNDLE_ID_SUFFIX = .dev
PRODUCT_BUNDLE_IDENTIFIER = com.fab.wab.merchant$(BUNDLE_ID_SUFFIX)

// Per-developer overrides (team, free-account entitlements); optional and git-ignored.
#include? "Local.xcconfig"
